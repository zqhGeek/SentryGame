# 默认按文本处理并统一仓库换行
* text=auto eol=lf

# Unity 文本资源
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
